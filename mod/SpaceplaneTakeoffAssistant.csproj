<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SpaceplaneTakeoffAssistant</AssemblyName>
    <RootNamespace>SpaceplaneTakeoffAssistant</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    KSPRoot is normally passed by the installer (takeoff-assistant install / update).
    For manual builds:  dotnet build -c Release -p:KSPRoot="/path/to/Kerbal Space Program"
    The Managed folder differs per OS and is auto-detected.
  -->
  <PropertyGroup>
    <KSPManaged Condition="Exists('$(KSPRoot)/KSP_x64_Data/Managed')">$(KSPRoot)/KSP_x64_Data/Managed</KSPManaged>
    <KSPManaged Condition="'$(KSPManaged)' == '' And Exists('$(KSPRoot)/KSP.app/Contents/Resources/Data/Managed')">$(KSPRoot)/KSP.app/Contents/Resources/Data/Managed</KSPManaged>
    <KSPManaged Condition="'$(KSPManaged)' == '' And Exists('$(KSPRoot)/KSP_Data/Managed')">$(KSPRoot)/KSP_Data/Managed</KSPManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPManaged)/Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(KSPManaged)/Assembly-CSharp-firstpass.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPManaged)/UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPManaged)/UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(KSPManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(KSPManaged)/UnityEngine.AudioModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(KSPManaged)/UnityEngine.InputLegacyModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(KSPManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <Target Name="CheckKSPPath" BeforeTargets="ResolveAssemblyReferences;CoreCompile" Condition="'$(KSPManaged)' == ''">
    <Error Text="Could not find KSP's Managed folder under KSPRoot='$(KSPRoot)'. Pass -p:KSPRoot=&quot;/path/to/Kerbal Space Program&quot; (the folder that contains GameData)." />
  </Target>

  <!-- Developer convenience: a plain 'dotnet build -p:KSPRoot=...' also copies into GameData.
       The installer passes -p:SkipDeploy=true and does its own tracked copy instead. -->
  <Target Name="DeployToKSP" AfterTargets="Build" Condition="'$(KSPManaged)' != '' And '$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <GameDataFiles Include="$(MSBuildProjectDirectory)/GameData/SpaceplaneTakeoffAssistant/Sounds/*.wav" />
    </ItemGroup>
    <MakeDir Directories="$(KSPRoot)/GameData/SpaceplaneTakeoffAssistant/Plugins;$(KSPRoot)/GameData/SpaceplaneTakeoffAssistant/Sounds;$(KSPRoot)/GameData/SpaceplaneTakeoffAssistant/PluginData" />
    <Copy SourceFiles="$(OutputPath)SpaceplaneTakeoffAssistant.dll" DestinationFolder="$(KSPRoot)/GameData/SpaceplaneTakeoffAssistant/Plugins" />
    <Copy SourceFiles="@(GameDataFiles)" DestinationFolder="$(KSPRoot)/GameData/SpaceplaneTakeoffAssistant/Sounds" />
    <Message Importance="high" Text="Deployed to $(KSPRoot)/GameData/SpaceplaneTakeoffAssistant" />
  </Target>

</Project>
