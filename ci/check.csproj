<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the mod sources against tiny stand-ins for the KSP/Unity API (no KSP install needed).
       Catches syntax/type errors in CI. It cannot prove the real KSP API matches the stand-ins. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs.cs" />
    <Compile Include="../mod/src/**/*.cs" />
  </ItemGroup>
</Project>
